+pub fn migrate(deps: DepsMut, env: Env, msg: MigrateMsg) -> Result<Response, ContractError> {
+    // Wasmd authorizes admin/governance. These independent guards prevent
+    // accidental use on legitimate collections or a changed snapshot.
+    if !crate::retirement_targets::TARGETS.contains(&env.contract.address.as_str()) {
+        return Err(cosmwasm_std::StdError::generic_err("not a reviewed retirement target").into());
+    }
+    let version = get_contract_version(deps.storage)?;
+    let nft = Pg721MetadataContract::default();
+    if version.contract != CONTRACT_NAME || version.version != CONTRACT_VERSION
+        || version.version != msg.expected_version
+        || nft.minter.load(deps.storage)?.as_str() != msg.minter
+        || nft.token_count(deps.storage)? != msg.expected_count
+        || MIGRATION_STATUS.load(deps.storage)?.done != msg.expected_migration_done {
+        return Err(cosmwasm_std::StdError::generic_err("retirement snapshot precondition failed").into());
